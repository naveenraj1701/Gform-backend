<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 40px;
        }

        .question {
            margin-bottom: 25px;
        }

        .answer {
            margin: 8px 0;
        }

        .question-image {
            width: 300px;
            max-height: 300px;
            object-fit: contain;
            margin-top: 10px;
        }
    </style>
</head>

<body>

    <h1>
        <%= title %>
    </h1>

    <p>
        <%= description %>
    </p>

    <% questions.forEach((question, index)=> { %>
        <div class="question">

            <h3>
                <%= index + 1 %>. <%= question.name %>
            </h3>

            <% if (question.type==="image" && question.image) { %>

                <img src="http://localhost:4001/<%= question.image.filepath %>" class="question-image">

                <% } %>

                    <% if (question.type !=="image" ) { %>

                        <% question.answers.forEach((answer)=> { %>
                            <div class="answer">
                                ☐ <%= answer %>
                            </div>
                            <% }) %>

                                <% } %>

        </div>
        <% }) %>

</body>

</html>